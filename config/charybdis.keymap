#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&lt {
    tapping-term-ms = <190>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";

        ParaLeft {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <6 7>;
            timeout-ms = <50>;
            slow-release;
        };

        ParaRight {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <8 9>;
            timeout-ms = <50>;
            slow-release;
        };

        BrakLeft {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <26 27>;
            timeout-ms = <50>;
            slow-release;
        };

        BrakRight {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <28 29>;
            timeout-ms = <50>;
            slow-release;
        };

        Esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            timeout-ms = <50>;
            slow-release;
        };

        Tab {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
            timeout-ms = <50>;
            slow-release;
        };

        Colon {
            bindings = <&kp COLON>;
            key-positions = <12 13>;
            timeout-ms = <50>;
            slow-release;
        };

        Quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <18 19>;
            timeout-ms = <50>;
            slow-release;
        };

        Enter {
            bindings = <&kp ENTER>;
            key-positions = <16 17>;
            timeout-ms = <50>;
            slow-release;
        };

        Ctrl_A {
            bindings = <&kp LC(A)>;
            key-positions = <10 22>;
            timeout-ms = <50>;
            slow-release;
        };

        Ctrl_Z {
            bindings = <&kp LC(Z)>;
            key-positions = <22 20>;
            timeout-ms = <50>;
            slow-release;
        };

        Ctrl_Q {
            bindings = <&kp LC(Q)>;
            key-positions = <22 0>;
            timeout-ms = <50>;
            slow-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
&mt LCTRL Q  &kp W  &kp E         &kp R  &kp T        &kp Y     &kp U        &kp I          &kp O    &kp P
&kp A        &kp S  &kp D         &kp F  &kp G        &kp H     &kp J        &kp K          &kp L    &kp SEMI
&kp Z        &kp X  &kp C         &kp V  &kp B        &kp N     &kp M        &kp COMMA      &kp DOT  &kp FSLH
                    &kp CAPSLOCK  &mo 1  &kp LSHFT    &kp RALT  &lt 2 SPACE  &kp RIGHT_GUI
            >;
        };

        NAV {
            bindings = <
&kp ESC  &none     &kp UP_ARROW  &none      &none    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &out OUT_TOG
&none    &kp LEFT  &kp DOWN      &kp RIGHT  &none    &kp GRAVE          &kp INS          &kp HOME              &kp PAGE_UP           &kp BACKSPACE
&none    &none     &none         &none      &none    &kp BACKSLASH      &kp DELETE       &kp END               &kp PAGE_DOWN         &none
                   &none         &none      &none    &none              &mo 3            &none
            >;
        };

        NUM {
            bindings = <
&kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp N6  &kp N7  &kp N8  &kp N9      &kp N0
&none   &none   &none   &none   &none     &none   &none   &none   &kp MINUS   &kp EQUAL
&none   &none   &none   &none   &none     &none   &none   &none   &kp PERIOD  &none
                &none   &mo 3   &none     &none   &none   &none
            >;
        };

        FUNC {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &kp F6  &kp F7  &kp F8  &kp F9   &kp F10
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &trans
                &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
